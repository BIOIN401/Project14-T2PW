  "protein:NdmA|H9N289": {
    "status": "ok",
    "uniprot_id": "H9N289",
    "recommended_name": "Methylxanthine N1-demethylase NdmA",
    "alternative_names": [
      "1-methylxanthine demethylase"
    ],
    "gene_names": [
      "ndmA"
    ],
    "organism": "Pseudomonas putida",
    "taxonomy_id": "303",
    "function_text": "Involved in the caffeine degradation, which is the essential first step for assimilating the carbon and nitrogen in caffeine. Catalyzes the N1-demethylation of caffeine to produce theobromine and formaldehyde. Also catalyzes the N1-demethylation of theophylline, paraxanthine, and 1-methylxanthine to 3-methylxanthine, 7-methylxanthine, and xanthine, respectively. NADH is the preferred substrate",
    "catalytic_activity": [
      "caffeine + NADH + O2 + H(+) = theobromine + formaldehyde + NAD(+) + H2O",
      "caffeine + NADPH + O2 + H(+) = theobromine + formaldehyde + NADP(+) + H2O",
      "theophylline + NADH + O2 + H(+) = 3-methylxanthine + formaldehyde + NAD(+) + H2O",
      "theophylline + NADPH + O2 + H(+) = 3-methylxanthine + formaldehyde + NADP(+) + H2O",
      "1,7-dimethylxanthine + NADH + O2 + H(+) = 7-methylxanthine + formaldehyde + NAD(+) + H2O",
      "1,7-dimethylxanthine + NADPH + O2 + H(+) = 7-methylxanthine + formaldehyde + NADP(+) + H2O"
    ],
