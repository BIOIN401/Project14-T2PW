  "protein:OPR3|Q9FUP0": {
    "status": "ok",
    "uniprot_id": "Q9FUP0",
    "recommended_name": "12-oxophytodienoate reductase 3",
    "alternative_names": [
      "12-oxophytodienoate-10,11-reductase 3",
      "Protein DELAYED DEHISCENCE 1"
    ],
    "gene_names": [
      "OPR3",
      "DDE1"
    ],
    "organism": "Arabidopsis thaliana",
    "taxonomy_id": "3702",
    "function_text": "Specifically cleaves olefinic bonds in cyclic enones (PubMed:11094980). Involved in the biosynthesis of jasmonic acid (JA) and perhaps in biosynthesis or metabolism of other oxylipin signaling moleclules (PubMed:10872231, PubMed:10973494, PubMed:29291349). Required for the spatial and temporal regulation of JA levels during dehiscence of anthers, promoting the stomium degeneration program (PubMed:10899973, PubMed:10973494). In vitro, reduces 9S,13S-12-oxophytodienoic acid (9S,13S-OPDA) and 9R,13R-OPDA to 9S,13S-OPC-8:0 and 9R,13R-OPC-8:0, respectively (PubMed:10872231). Can detoxify the explosive 2,4,6-trinitrotoluene (TNT) in vitro by catalyzing its nitroreduction to form hydroxylamino-dinitrotoluene (HADNT) (PubMed:19605548)",
    "catalytic_activity": [
      "(1S,2S)-OPC-8 + NADP(+) = (9S,13S,15Z)-12-oxophyto-10,15-dienoate + NADPH + H(+)"
    ],
    "enzyme_commission": [
