  "protein:ALAS2|P22557": {
    "status": "ok",
    "uniprot_id": "P22557",
    "recommended_name": "5-aminolevulinate synthase, erythroid-specific, mitochondrial",
    "alternative_names": [
      "5-aminolevulinic acid synthase 2",
