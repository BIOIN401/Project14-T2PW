  "protein:Bs AcuA acetyltransferase|P39065": {
    "status": "ok",
    "uniprot_id": "P39065",
    "recommended_name": "Acetoin utilization protein AcuA",
    "alternative_names": [
      "Protein acetyltransferase AcuA"
    ],
    "gene_names": [
      "acuA"
    ],
    "organism": "Bacillus subtilis (strain 168)",
    "taxonomy_id": "224308",
    "function_text": "An acetyltransferase responsible for catalyzing the N6-acetylation of lysine residues in various enzymes (PubMed:16855235, PubMed:18487328, PubMed:19136592, PubMed:39019872, PubMed:39422507, PubMed:40089509). Inactivates acetyl-CoA synthetase AcsA via acetylation at 'Lys-549' (PubMed:16855235, PubMed:18487328, PubMed:19136592, PubMed:39019872, PubMed:40089509). Inhibits the activity of AcsA via two modes, first by binding to its C-terminal domain and then by acetylating it (PubMed:39019872, PubMed:40089509). The AcuA-AcsA complex possesses intrinsic phosphotransacetylase activity, generating acetyl-CoA from acetylphosphate and CoA, which is subsequently used by AcuA as an acetyl-group donor molecule to catalyze the acetylation of AcsA at 'Lys-549' (PubMed:39019872). Also acetylates MenE at 'Lys-471' in the presence of acetyl-CoA in vitro, probably to reduce cell growth (PubMed:39422507). Part of the acuABC operon, which is possibly involved in the breakdown of acetoin and butanediol (PubMed:7934817)",
    "catalytic_activity": [
      "L-lysyl-[protein] + acetyl-CoA = N(6)-acetyl-L-lysyl-[protein] + CoA + H(+)"
    ],
    "enzyme_commission": [],
    "pathways": [
