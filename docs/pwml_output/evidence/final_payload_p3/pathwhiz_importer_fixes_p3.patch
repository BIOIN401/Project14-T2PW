+  # Maps each PWML transport-transporter id to the created record, as store_reaction_enzyme_ids does for reaction enzymes.
+  def store_transport_transporter_ids(node, transport)
+    node.xpath('transport-transporters/transport-transporter').each do |tt_node|
+      pwml_id = tt_node.xpath('id').first.try(:content)
+      protein_complex_id = @protein_complex_list[tt_node.xpath('protein-complex-id').first.try(:content)]
+      transporter = transport.get_enzyme(protein_complex_id) if protein_complex_id.present?
+      @transport_transporter_list[pwml_id] = transporter.id if pwml_id.present? && transporter.present?
+    end
+  end
