        <sub-pathway-visualizations/>
        <vacuous-compound-visualizations/>
        <vacuous-edge-visualizations/>
        <vacuous-nucleic-acid-visualizations/>
        <vacuous-element-collection-visualizations/>
        <vacuous-protein-visualizations/>
        <drawable-element-locations/>
        <membrane-visualizations/>
        <label-locations/>
        <zoom-visualizations/>
      </pathway-visualization>
    </pathway-visualization-context>
  </pathway-visualization-contexts>
</super-pathway-visualization>
