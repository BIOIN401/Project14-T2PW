          <compound>
            <id type="integer">190</id>
            <name>Phosphoribosyl pyrophosphate</name>
            <hmdb-id>HMDB0000280</hmdb-id>
            <description>Phosphoribosyl pyrophosphate (PRPP) is a pentosephosphate. The key substance in the biosynthesis of histidine, tryptophan, and purine and pyrimidine nucleotides. It is formed from ribose 5-phosphate by the enzyme ribose-phosphate diphosphokinase. It plays a role in transferring phosphate groups in several reactions. (Wikipedia).</description>
            <cas>7540-64-9</cas>
            <kegg-id>C00119</kegg-id>
            <pubchem-cid>7339</pubchem-cid>
