        case = _case(case_id)
        expect = case["expect"]
        result = quarantine_and_close(deepcopy(case["payload"]), strict_db=True)
    
        # "smaller" is short for "a smaller VALID strict graph". A refused case
        # shrank plenty -- that is what refusal looks like from the inside -- but it
