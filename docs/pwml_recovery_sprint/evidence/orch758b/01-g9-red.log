                stage=stage_name,
                boundary=BOUNDARY_STAGE1_LADDER_CHECKPOINT,
                attempts=int(getattr(record, "sequence", 0) or 0),
                outcome=OUTCOME_OK,
                ladder_checkpoint=record.to_dict(),
