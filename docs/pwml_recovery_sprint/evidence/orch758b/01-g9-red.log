            except BaseException as exc:  # noqa: BLE001 - recorded, then re-raised as-is
                if ladder is not None and is_operation_timeout(exc):
                    _record_termination(
                        OPERATION_TIMEOUT,
                        outcome=OUTCOME_EMPTY_COMPLETION,
                        error=f"{exc.__class__.__name__}: {exc}",
                    )
                raise
    
