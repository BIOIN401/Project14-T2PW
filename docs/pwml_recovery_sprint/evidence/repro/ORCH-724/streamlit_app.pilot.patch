 #: artifact hand-off in the app sat downstream of an ``st.stop()``.
 logger = logging.getLogger(__name__)
 
+
+def _bounded_env_int(name: str, default: int, *, minimum: int, maximum: int) -> int:
+    """Read an integer UI default from the environment and keep it in range."""
+    raw = os.getenv(name)
+    if raw is None or not raw.strip():
+        return default
+    try:
+        value = int(raw)
+    except ValueError:
+        logger.warning("Ignoring invalid %s=%r; using %d.", name, raw, default)
+        return default
+    if value < minimum or value > maximum:
+        clamped = min(max(value, minimum), maximum)
+        logger.warning(
+            "Clamping %s=%d to the supported UI range %d..%d.",
+            name,
+            value,
+            minimum,
+            maximum,
+        )
+        return clamped
+    return value
+
 EXTRACTION_DIAGNOSTICS_KEY = "extraction_diagnostics"
 
