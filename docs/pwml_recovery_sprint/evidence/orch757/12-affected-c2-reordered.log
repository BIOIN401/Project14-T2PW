                        stage_name or "chat",
                        resolved_model,
                        reason,
                        empty_attempts,
                        max_retries,
                    )
                    diagnostics.terminal_reason = TERMINAL_EMPTY_AFTER_RETRIES
                    return CompletionResult("", diagnostics)
    
                text = (resp.choices[0].message.content or "").strip()
                reason = _finish_reason(resp)
                diagnostics.note(
