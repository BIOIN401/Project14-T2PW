                        report=rep,
                        extra_components=parts[2:],
                        source_token=name,
                        caller="normalize_composites",
                    )
                    rep["rewrite_map"][_composite_key(name)] = canonical
                    rep["rewrite_map"][_normalize(name)] = canonical
                    _remove_entity(complexes, name)
