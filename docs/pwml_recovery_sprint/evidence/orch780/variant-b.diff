+def _unsupported_reactions(
+    candidate: Mapping[str, Any], by_position: Mapping[str, Sequence[Mapping[str, Any]]]
+) -> List[Dict[str, Any]]:
+    """D-116 s1 (ORCH-780): every reaction the support gate's own row predicate calls unsupported.
+
+    The predicate is ``reaction_support.reaction_support_class(row) is None``, the very
+    test ``evaluate_reaction_support`` counts, read where the gate reads it, on the
+    freeze candidate; and, as there, only while ``lineage_carrier_active``: with no
+    carrier, support is unknown rather than absent and the gate abstains, so nothing
+    is omitted. Runs before the other checks whether or not some other reaction is
+    supported, so an unsupported row is always recorded under the gate's own code.
+    The gate is not touched and still refuses a payload in which no reaction is
+    supported (D-116 s2).
+    """
+
+    from t2pw.pipeline.reaction_support import (
+        CODE_NO_DEFENSIBLE_REACTION_SUPPORT,
+        lineage_carrier_active,
+        reaction_support_class,
+    )
+
+    if not lineage_carrier_active(candidate):
+        return []
+    rows = _safe_list(_safe_dict(candidate.get("processes")).get("reactions"))
+    return [
+        {"kind": "process", "record": record, "slot": "", "position": None, "name": "",
+         "reason": CODE_NO_DEFENSIBLE_REACTION_SUPPORT, "gate": _GATE_REQUIRED}
+        for record, row in zip(by_position.get("reactions") or [], rows)
+        if isinstance(row, Mapping) and reaction_support_class(row) is None
+    ]
+
