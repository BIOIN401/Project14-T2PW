  "rules": [
    {
      "rule": "named_gap",
      "requires": "the candidate names a gap_id that was actually detected"
    },
    {
      "rule": "valid_entity_types",
      "requires": "every participant and catalyst is a plausible species / protein token"
    },
    {
      "rule": "local_evidence_span",
      "requires": "the candidate points at ONE bounded span of its chunk, which is a single statement (one sentence, or one parsed equation line)"
    },
    {
      "rule": "evidence_supports_participants",
      "requires": "the span's own parsed substrates and products are the claim's, matched on whole-name boundaries"
    },
    {
      "rule": "relation_agrees",
      "requires": "the span STATES this reaction — its parsed substrates, products and direction agree with the claim; co-occurrence of names is not a relation and a reversed span refutes a forward claim"
    },
    {
      "rule": "no_unsupported_catalyst",
      "requires": "every catalyst claimed is the catalyst the span attaches to THIS relation, not merely a protein named nearby"
    },
    {
      "rule": "organism_compatible",
      "requires": "the organism observed in the span (else the paper's observed metadata) matches the requested one, is a related taxon, or is explicitly unknown and the configured policy allows unknown"
    },
    {
      "rule": "requested_pathway",
      "requires": "the span / observed metadata does not name a DIFFERENT pathway (strict policy additionally requires a positive pathway match)"
    },
    {
      "rule": "gap_type_compatible",
      "requires": "the candidate is the KIND of evidence the gap asks for: a reaction can fill a connectivity gap, but a missing_compartment gap needs a location assertion and an unmapped_enzyme gap needs identifier evidence"
    },
    {
      "rule": "connects_to_pathway",
      "requires": "a SUBSTRATE OR PRODUCT of the candidate is an existing pathway metabolite or the gap's expected anchor — catalysts never connect"
    },
    {
      "rule": "fills_its_named_gap",
      "requires": "a substrate or product of the candidate is the gap's target, directly or within the configured hop limit through metabolites contributed by reactions already admitted for that same gap"
    },
    {
      "rule": "gap_not_already_covered",
      "requires": "for a connectivity gap: no existing reaction already has every substrate and product of this candidate, same side, same direction"
    },
    {
      "rule": "not_already_admitted_for_another_gap",
      "requires": "one canonical claim from one span is admitted once; it carries every gap id it was retrieved for"
    }
