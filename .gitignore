.env.*
.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
.pytest_run_tmp/
.ruff_cache/
pytest_basetemp/
tmp/
out/
outputs/
.pytest_tmp/
.pytest_wt_tmp/
# Every ad-hoc pytest --basetemp directory. These are run artifacts: one full
# suite leaves ~160 JSON files under .pytest_tmp_baseline/ alone, and they were
# being committed. The glob covers the ones already in use
# (.pytest_tmp_baseline/, .pytest_tmp_unknown/, .pytest_tmp_verify_*/) and any
# future .pytest_tmp_<label>/ without another .gitignore edit.
.pytest_tmp*/
temp_pytest_probe/

# RAG (optional) local, rebuildable evidence index + embedding cache (WP0).
data/rag_index/

# Agent worktrees for the PWML recovery sprint. Each implementer branch gets an
# isolated checkout here (.claude/settings.json -> worktree.baseRef = "head").
# These are working copies of tracked content, never a source of truth.
.claude/worktrees/

# Per-run lookup-cache snapshots under runs_verify/ (DECISIONS.md D-011, O-2).
# 8 dirs x 38 MB = 304 MB against a 159 MB .git, and every byte is a regenerable
# copy of data/enrichment_cache.json + data/id_mapping_cache.json.
#
# Deliberately NARROW: it matches runs_verify/*/cache_snapshot/ only. The 16
# cache_snapshot files already tracked under the older runs/ stay tracked --
# this rule does not reach them, and untracking history is not what was decided.
# The existing directories are NOT deleted; that is a separate, recoverable
# housekeeping call.
runs_verify/*/cache_snapshot/

# Captured child stdout under the G11 durable-evidence tree. The committed
# artifact there is the structured JSON cleanup report, never a log dump.
#
# Deliberately NARROW, like the rule above: it matches only log/stdout captures
# inside docs/pwml_recovery_sprint/evidence/g11/, so the .json reports -- the
# whole point of that directory -- stay tracked. g11_evidence.py rejects any
# non-.json file there as well, so this is a backstop, not the only guard.
docs/pwml_recovery_sprint/evidence/g11/**/*.log
docs/pwml_recovery_sprint/evidence/g11/**/*.out
docs/pwml_recovery_sprint/evidence/g11/**/*.out.txt

# C-063 (F-071): the G11 reservation staging area. `g11_evidence.py next` creates
# the placeholder HERE, and `bounded_run.py` promotes it into the reports tree with
# one `os.replace` when the job actually produces a report. A job whose caller dies
# first therefore leaves its orphan in `.staging/` rather than in the reports tree,
# which is exactly what stops an unfinished job turning whole-tree G11 red.
#
# It must be IGNORED as well as invisible to `check`. REV-063 measured the gap:
# `git add -A` staged `g11/H-004/.staging/01-orphan.json`, and the comment above
# RESERVED_KEY promises such a file is "never committed". Without this rule that
# promise holds only outside `.staging/`.
#
# Narrow on purpose: it matches the staging directory only, so every promoted
# report -- the whole point of the tree -- stays tracked.
docs/pwml_recovery_sprint/evidence/g11/*/.staging/
