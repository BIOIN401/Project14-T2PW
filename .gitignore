# Every ad-hoc pytest --basetemp directory. These are run artifacts: one full
# suite leaves ~160 JSON files under .pytest_tmp_baseline/ alone, and they were
# being committed. The glob covers the ones already in use
# (.pytest_tmp_baseline/, .pytest_tmp_unknown/, .pytest_tmp_verify_*/) and any
# future .pytest_tmp_<label>/ without another .gitignore edit.
.pytest_tmp*/
temp_pytest_probe/

# RAG (optional) local, rebuildable evidence index + embedding cache (WP0).
data/rag_index/

# Agent worktrees for the PWML recovery sprint. Each implementer branch gets an
# isolated checkout here (.claude/settings.json -> worktree.baseRef = "head").
# These are working copies of tracked content, never a source of truth.
.claude/worktrees/
